# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL — find it in Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / public key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backend API ────────────────────────────────────────────────────────────────
# The browser always calls /api on this site; Next.js forwards it here, so the
# session cookie is first-party. Leave empty behind the Docker nginx proxy
# (nginx routes /api). NEXT_PUBLIC_API_URL is still read as a fallback.
API_PROXY_TARGET=http://localhost:5000
