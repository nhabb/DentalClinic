# App/runtime URL. For Supabase production apps this is often the pooled connection string.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.dvyxhakaszgkvzknfuli.supabase.co:5432/postgres?sslmode=require"

# Prisma CLI direct connection, preferred for `prisma db pull` and migrations.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.dvyxhakaszgkvzknfuli.supabase.co:5432/postgres?sslmode=require"

# OpenAI API key for the AI agent (get from platform.openai.com)
OPENAI_API_KEY="sk-proj-your-openai-key-here"

# -- Email (password setup links for clinic-created patients) ------------------
# Public URL of the frontend, used to build links in emails.
FRONTEND_URL=http://localhost:3000
# Leave SMTP_HOST empty in local dev: emails are logged to the console and the
# setup link is shown to staff in the admin UI so it can be shared manually.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BrightSmile Dental <no-reply@example.com>"
# How long a password setup link stays valid (hours).
PASSWORD_SETUP_TTL_HOURS=72
CLINIC_NAME="BrightSmile Dental Clinic"

# -- Multi-tenancy -------------------------------------------------------------
# Organization (tenant) used for requests that carry no token and name no tenant
# (signup, login page, public doctor list). Optional when only one organization
# exists. Anonymous requests can also pick a tenant with the X-Organization
# header (slug) or by using the tenant's subdomain.
DEFAULT_ORGANIZATION_SLUG=brightsmile
# Database role the backend switches each connection into so row-level security
# applies (the Supabase `postgres` login bypasses RLS). Created by the
# 20261008120000_multi_tenant_rls migration. Set to an empty value only for a
# local database without that role; RLS is then not enforced.
DB_APP_ROLE=dental_app
