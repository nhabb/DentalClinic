# Same database as the clinic backend (session-mode pooler or direct connection).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# Secret for platform tokens. Must differ from the clinic backend's JWT_SECRET so a
# clinic token can never be used on the platform API and vice versa.
PLATFORM_JWT_SECRET=change-me-to-a-long-random-string

# Port of this API (the clinic backend uses 5000).
PORT=5100

# Public URL of the clinic app; onboarding emails/links send new clinic owners there
# to set their password (they log in to their clinic, not to this console).
CLINIC_APP_URL=http://localhost:3000

# Origin of the platform console frontend, for CORS.
PLATFORM_APP_URL=http://localhost:3100

# How long an onboarding password link stays valid (hours).
PASSWORD_SETUP_TTL_HOURS=72
