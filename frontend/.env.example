# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL — find it in Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / public key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backend API ────────────────────────────────────────────────────────────────
# Leave empty when running behind the Docker nginx proxy (relative /api paths).
# Set to http://localhost:5000 for local development against the NestJS server.
NEXT_PUBLIC_API_URL=http://localhost:5000
