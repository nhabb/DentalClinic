generator client {
  provider = "prisma-client"
  output   = "../src/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model appointment_slots {
  id           BigInt         @id @default(autoincrement())
  doctor_id    BigInt
  slot_date    DateTime       @db.Date
  start_time   DateTime       @db.Time(6)
  end_time     DateTime       @db.Time(6)
  is_booked    Boolean        @default(false)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  users        users          @relation(fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments appointments[]

  @@index([slot_date], map: "idx_slots_date")
  @@index([doctor_id], map: "idx_slots_doctor_id")
  @@index([is_booked], map: "idx_slots_is_booked")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointments {
  id                                   BigInt             @id @default(autoincrement())
  patient_id                           BigInt
  appointment_date                     DateTime           @db.Date
  start_time                           DateTime           @db.Time(6)
  end_time                             DateTime           @db.Time(6)
  status                               String             @default("pending")
  reason                               String?
  notes                                String?
  created_by                           BigInt?
  created_at                           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime           @default(now()) @db.Timestamptz(6)
  doctor_id                            BigInt
  slot_id                              BigInt?
  users_appointments_created_byTousers users?             @relation("appointments_created_byTousers", fields: [created_by], references: [id], onUpdate: NoAction)
  users_appointments_doctor_idTousers  users              @relation("appointments_doctor_idTousers", fields: [doctor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "appointments_doctor_fkey")
  patient_profiles                     patient_profiles   @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "appointments_patient_fkey")
  appointment_slots                    appointment_slots? @relation(fields: [slot_id], references: [id], onUpdate: NoAction)
  patient_records                      patient_records[]

  @@index([appointment_date], map: "idx_appointments_date")
  @@index([doctor_id], map: "idx_appointments_doctor_id")
  @@index([patient_id], map: "idx_appointments_patient_id")
  @@index([status], map: "idx_appointments_status")
  @@index([patient_id, status], map: "idx_appointments_patient_status")
}

model audit_logs {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt?
  action     String
  table_name String
  record_id  BigInt?
  old_data   Json?
  new_data   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_logs_user_fkey")

  @@index([table_name], map: "idx_audit_logs_table_name")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

model clinic_profile {
  id            BigInt   @id @default(autoincrement())
  name          String   @db.VarChar
  phone         String?  @db.VarChar
  email         String?  @db.VarChar
  address       String?
  website_url   String?
  logo_url      String?
  description   String?
  opening_hours String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_items {
  id                  BigInt                @id @default(autoincrement())
  name                String                @db.VarChar
  category            String?               @db.VarChar
  description         String?
  sku                 String?               @unique @db.VarChar
  quantity            Int                   @default(0)
  minimum_quantity    Int                   @default(0)
  unit                String?               @default("piece") @db.VarChar
  cost_price          Decimal?              @default(0) @db.Decimal(12, 2)
  image_url           String?               @db.VarChar
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  inventory_movements inventory_movements[]

  @@index([name], map: "idx_inventory_items_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_movements {
  id              BigInt          @id @default(autoincrement())
  item_id         BigInt
  movement_type   String
  quantity        Int
  note            String?
  performed_by    BigInt?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  inventory_items inventory_items @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inventory_movements_item_fkey")
  users           users?          @relation(fields: [performed_by], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_inventory_movements_created_at")
  @@index([item_id], map: "idx_inventory_movements_item_id")
}

model notifications {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  title      String
  message    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([is_read], map: "idx_notifications_is_read")
  @@index([user_id], map: "idx_notifications_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model patient_documents {
  id               BigInt           @id @default(autoincrement())
  patient_id       BigInt
  record_id        BigInt?
  file_name        String           @db.VarChar
  file_path        String
  document_type    String?
  uploaded_by      BigInt?
  uploaded_at      DateTime         @default(now()) @db.Timestamptz(6)
  patient_profiles patient_profiles @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "patient_documents_patient_fkey")
  patient_records  patient_records? @relation(fields: [record_id], references: [id], onUpdate: NoAction, map: "patient_documents_record_fkey")
  users            users?           @relation(fields: [uploaded_by], references: [id], onUpdate: NoAction)

  @@index([patient_id], map: "idx_patient_documents_patient_id")
  @@index([record_id], map: "idx_patient_documents_record_id")
}

model patient_profiles {
  id                      BigInt              @id @default(autoincrement())
  user_id                 BigInt              @unique
  emergency_contact_name  String?             @db.VarChar
  emergency_contact_phone String?             @db.VarChar
  blood_type              String?             @db.VarChar
  allergies               String?
  medical_notes           String?
  created_at              DateTime            @default(now()) @db.Timestamptz(6)
  updated_at              DateTime            @default(now()) @db.Timestamptz(6)
  city                    String?             @db.VarChar
  current_medications     String?
  governate               String?             @db.VarChar
  insurance_policy        String?             @db.VarChar
  insurance_provider      String?             @db.VarChar
  profile_complete        Boolean             @default(false)
  photo_url               String?
  appointments            appointments[]
  patient_documents       patient_documents[]
  users                   users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "patient_profiles_user_fkey")
  patient_records         patient_records[]
  treatment_invoices      treatment_invoices[]

  @@index([user_id], map: "idx_patient_profiles_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model patient_records {
  id                BigInt              @id @default(autoincrement())
  patient_id        BigInt
  appointment_id    BigInt?
  record_type       String              @default("general_note")
  title             String              @db.VarChar
  description       String
  tooth_number      String?
  treatment_date    DateTime?           @db.Date
  created_by        BigInt?
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  patient_documents patient_documents[]
  appointments      appointments?       @relation(fields: [appointment_id], references: [id], onUpdate: NoAction, map: "patient_records_appointment_fkey")
  users             users?              @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  patient_profiles  patient_profiles    @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "patient_records_patient_fkey")

  @@index([appointment_id], map: "idx_patient_records_appointment_id")
  @@index([patient_id], map: "idx_patient_records_patient_id")
  @@index([record_type], map: "idx_patient_records_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                          BigInt                @id @default(autoincrement())
  email                                       String                @unique @db.VarChar
  password_hash                               String
  first_name                                  String                @db.VarChar
  last_name                                   String                @db.VarChar
  phone                                       String?               @db.VarChar
  date_of_birth                               DateTime?             @db.Date
  gender                                      String?
  address                                     String?
  role                                        String                @default("patient")
  is_active                                   Boolean               @default(true)
  avatar_url                                  String?
  created_at                                  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime              @default(now()) @db.Timestamptz(6)
  appointment_slots                           appointment_slots[]
  appointments_appointments_created_byTousers appointments[]        @relation("appointments_created_byTousers")
  appointments_appointments_doctor_idTousers  appointments[]        @relation("appointments_doctor_idTousers")
  audit_logs                                  audit_logs[]
  inventory_movements                         inventory_movements[]
  notifications                               notifications[]
  patient_documents                           patient_documents[]
  patient_profiles                            patient_profiles?
  patient_records                             patient_records[]
  expenses                                    expenses[]
  treatment_invoices_created                  treatment_invoices[] @relation("treatment_invoices_creator")
  invoice_payments_created                    invoice_payments[]   @relation("invoice_payments_creator")

  @@index([role], map: "idx_users_role")
}


model expenses {
  id           BigInt   @id @default(autoincrement())
  title        String   @db.VarChar
  category     String   @default("other") @db.VarChar
  status       String   @default("pending") @db.VarChar
  amount       Decimal  @db.Decimal(10, 2)
  description  String?
  expense_date DateTime @db.Date
  created_by   BigInt?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  creator      users?   @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([expense_date], map: "idx_expenses_date")
  @@index([category], map: "idx_expenses_category")
}

model treatment_invoices {
  id               BigInt               @id @default(autoincrement())
  patient_id       BigInt
  procedure_date   DateTime             @db.Date
  notes            String?
  total_amount     Decimal              @db.Decimal(10, 2)
  amount_paid      Decimal              @default(0) @db.Decimal(10, 2)
  remaining_amount Decimal              @db.Decimal(10, 2)
  status           String               @default("open")
  created_by       BigInt?
  created_at       DateTime             @default(now()) @db.Timestamptz(6)
  updated_at       DateTime             @default(now()) @db.Timestamptz(6)

  patient          patient_profiles     @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator          users?               @relation("treatment_invoices_creator", fields: [created_by], references: [id], onUpdate: NoAction)
  line_items       invoice_line_items[]
  invoice_payments invoice_payments[]

  @@index([patient_id], map: "idx_treatment_invoices_patient_id")
  @@index([status], map: "idx_treatment_invoices_status")
  @@index([created_at], map: "idx_treatment_invoices_created_at")
}

model invoice_line_items {
  id             BigInt             @id @default(autoincrement())
  invoice_id     BigInt
  procedure_name String             @db.VarChar
  amount         Decimal            @db.Decimal(10, 2)
  created_at     DateTime           @default(now()) @db.Timestamptz(6)

  invoice        treatment_invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_invoice_line_items_invoice_id")
}

model invoice_payments {
  id             BigInt             @id @default(autoincrement())
  invoice_id     BigInt
  amount         Decimal            @db.Decimal(10, 2)
  payment_method String             @default("cash")
  notes          String?
  created_by     BigInt?
  created_at     DateTime           @default(now()) @db.Timestamptz(6)

  invoice        treatment_invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator        users?             @relation("invoice_payments_creator", fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([invoice_id], map: "idx_invoice_payments_invoice_id")
}
